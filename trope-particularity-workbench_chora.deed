;; SPDX-License-Identifier: MPL-2.0
;
; The repo deed of trope-particularity-workbench: the single machine-readable
; record of the repo (one-deed-per-repo doctrine, standards#837). It replaces
; the retired A2ML tree, frozen at
; https://github.com/hyperpolymath/trope-particularity-workbench/tree/b18eb67dcf10e80d3560b0468a7a85c484231f02/.machine_readable
; Grammar: standards 1-formats/deed/spec/abnf/deed.abnf.
(repo-deed
  :schema-version  "1.0.0"
  :canonical-name  "trope-particularity-workbench"
  :beholding-chora #u5"estate/chora"

  :repo-uuid       #u5"github.com/hyperpolymath/trope-particularity-workbench"

  (identity :primary-forge github
            :owner          "hyperpolymath"
            :prefixed-name  "nl-trope-particularity-workbench")

  (clade    :primary       nl
            :primary-name  "Nextgen Languages"
            :secondary     (fv)
            :assigned      "2026-10-06"
            :rationale     "Assigned 2026-10-06 by the A2ML retirement PR; the retired CLADE value rm was the template's own and never repo-specific. The workbench is the normative vocabulary (nine named effects, the residual, the verdict) that the haec language realises and trope-checker verifies, so nl with fv secondary. The family's earlier informal code vk is not one of the 12 registered clades.")

  (forges   :github    "hyperpolymath/trope-particularity-workbench"
            :gitlab    ""
            :bitbucket "")

  (lineage  :type              standalone
            :parent            ""
            :born              "2026-06-21"
            :previous-names    ()
            :instantiated-from "rsr-template-repo")

  (status   :phase         active
            :since         "2026-06-21"
            :present       #t
            :aliases       ()
            :merged-into   ""
            :superseded-by ""
            :successors    ()
            :ended         ""
            (history
              (entry :phase active
                     :since "2026-06-21"
                     :note  "specification: the nine named effects and the residual are written as prose in vocabulary/; tests/check-vocabulary.sh guards their shape")))

  (meta
        :version       "0.1.0"
        :last-updated  "2026-10-06"
        :type          documentation
        :languages     ()
        :license       MPL-2.0
        :author        "Jonathan D.A. Jewell (hyperpolymath)"
        :build-tool        just
        :container-runtime podman
        :ci-platform       github-actions
        :package-manager   guix
        :scoping-first   #t
        :execution-order  "axis-1 > axis-2 > axis-3"
        :axis-1           "must > intend > like"
        :axis-2  "corrective > adaptive > perfective"
        :axis-3  "systems > compliance > effects"
        (scoping
          :sources            "README, roadmap, status docs, maintenance checklist, CI/security docs"
          :marker-scan        "TODO/FIXME/XXX/HACK/STUB/PARTIAL"
          :idris-unsound-scan "believe_me/assert_total")
        :corrective-first  #t
        :adaptive-second   #t
        :adaptive-focus    "scope-change reconciliation, stale-reference removal, obsolete-work culling"
        :perfective-third  #t
        :perfective-source "axis-1 honest state after corrective/adaptive updates"
        (axis-3
          :audit-focus        "systems in place, documentation explains actual state, safety/security accounted for, observed effects reviewed"
          :compliance-focus   "seams/compromises/exception register, bounded exceptions, anti-drift checks"
          :drift-risk-example "single exception broadening into policy violation (e.g. ->TypeScript spread)"
          :effects-evidence   "benchmark execution/results and maintainer status dialogue/review"))

  (ecosystem
             :project           "trope-particularity-workbench"
             :ecosystem         "hyperpolymath"
             :position-type     "vocabulary"
             :purpose           "A diagnostic vocabulary for property-instance individuation and loss: the named effects, the residual, and the verdict."
             :not               ("a checker (that is trope-checker)" "a language (that is haec)" "a store (that is vocarium)")
             :pipeline-position "foundation"
             :chain             "Vocabulary track: trope-particularity-workbench → haec → trope-checker (verdict). Store/query track: haec → vocarium → hermeneia → trope-checker (verdict). trope-checker depends on nothing (HC-1); the workbench depends on nothing; vocarium and hermeneia meet at the M2 StoreProvider adapter (vocarium ADR-0002: wire, do not link)."
             :pipeline-notes    "Prose only. Depends on nothing; the other four repos cite it as the normative source of the effect names (HC-7)."
             :coordination      trope-checker
             (related :name "haec" :relationship realises :notes "the language whose type discipline is trope-particularity")
             (related :name "trope-checker" :relationship realises :notes "the verdict over Trope IR uses this vocabulary")
             (related :name "vocarium" :relationship consumer :notes "stores tropes named in this vocabulary")
             (related :name "hermeneia" :relationship consumer :notes "vokes over tropes named in this vocabulary"))

  (agentic
            :version "0.1.0" :last-updated "2026-10-06"
            (permissions  :source         #t
                          :tests          #t
                          :docs           #t
                          :config         #t
                          :create-files   #t)
            (integrity    :fail-closed                     #t
                          :require-evidence-per-step       #t
                          :allow-silent-skip               #f
                          :require-rerun-after-fix         #t
                          :release-claim-requires-hard-pass #t)
            (methodology :instructions-dir ".machine_readable/bot_directives/" :default-mode hybrid))

  (neurosym
             :version "0.1.0" :last-updated "2026-10-06"
             (hypatia :scan-enabled  #t
                      :scan-depth    standard
                      :report-format "logtalk"))

  (playbook
            :version "0.1.0" :last-updated "2026-10-06"
            (skeleton :version              "1.0"
                      :last-updated         "2026-10-06"
                      :authority-allowlist  ".machine_readable/root-allow.txt"
                      :enforcement-workflow ".github/workflows/estate-rules.yml")
            (deployment) (incident-response) (release-process) (docs-format) (maintenance-operations))
)
